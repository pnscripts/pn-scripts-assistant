# Keeps the static build context small and, more importantly, keeps developer
# state out of a binary that gets distributed.

.git
.env
.env.*
!.env.desktop.example

# Reinstalled inside the build with --no-dev, so dev dependencies never ship.
vendor
node_modules

# Compiled client binaries; the release workflow builds these separately per platform.
clients/cli/pnexus
clients/desktop/pnexus-desktop

storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
*.sqlite

# Generated from the *dev* dependency set, so it lists providers like
# laravel/pail that --no-dev correctly leaves out — the app then dies at boot
# looking for a class that isn't there. Regenerated in the build instead.
bootstrap/cache/packages.php
bootstrap/cache/services.php
bootstrap/cache/config.php
bootstrap/cache/routes-*.php

.github
docs
tests
