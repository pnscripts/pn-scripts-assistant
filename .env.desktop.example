# Desktop mode: no Docker, no Postgres, no Redis.
#
# Copy to .env beside the pnexus-brain binary. Everything here is chosen so the
# app can run from a single executable with no services installed — see ADR 0001.

APP_NAME="Pnexus"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8090

# SQLite lives next to the binary, so the whole brain is a folder you can copy.
DB_CONNECTION=sqlite
DB_DATABASE=./pnexus.sqlite

# The app itself lives inside the executable and is read-only, so Laravel's
# storage (compiled views, sessions, cache, logs) has to sit outside it.
# Set by the launcher; only needed for standalone builds.
PNEXUS_STORAGE_PATH=./storage

# No Redis in desktop mode. Lesson extraction runs on the database queue; run
# `pnexus-brain artisan queue:work` alongside, or `queue:work --once` on a timer.
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

BRAIN_NAME=Pnexus
BRAIN_OWNER=

# Ollama on the host. Not host.docker.internal here — nothing is containerised.
LLM_DEFAULT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Absolute paths to learn from. No container mounts in desktop mode, so the app
# reads these directly — and it only ever reads them.
SCAN_DEV_PROJECTS_READ_PATH=
SCAN_HOME_PROJECTS_READ_PATH=
SCAN_DOCUMENTS_READ_PATH=

BRAVE_SEARCH_API_KEY=
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
