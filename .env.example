APP_NAME="PN Brain"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090
APP_PORT=8090
WWWUSER=1000
WWWGROUP=1000

# Change these if the default Postgres/Redis ports are already taken on the host
# (internal container networking is unaffected).
FORWARD_DB_PORT=54329
FORWARD_REDIS_PORT=63790

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=ai_brain
DB_USERNAME=brain
DB_PASSWORD=

# Resolved automatically by scripts/start-brain.sh — do not hardcode a path here.
# This is where the portable "brain" (Postgres data, Redis data, logs) actually lives,
# on whichever drive is currently plugged in.
BRAIN_DATA_ROOT=

# Read-only scanning (mounted :ro — the brain can read these, never write to them)
SCAN_DEV_PROJECTS_PATH=
SCAN_HOME_PROJECTS_PATH=
SCAN_DOCUMENTS_PATH=

# Identity
# What may leave this machine: private | research | open (see app/Brain/Privacy.php)
BRAIN_PRIVACY=private
BRAIN_NAME="PN Brain"
BRAIN_OWNER=Petar

# Hybrid LLM routing
LLM_DEFAULT_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:7b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Web search: optional. Without a key, search scrapes DuckDuckGo's no-JS
# endpoint — works with no account, but can break if their markup changes.
BRAVE_SEARCH_API_KEY=

# Smart home. Home Assistant is the recommended route even for Tuya/Hue/Zigbee
# gear, since it already speaks all of them. The token is a long-lived access
# token from your HA profile page — treat it as a house key.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
