# Editors and desktops, which every checkout of this grows its own of.
.DS_Store
Thumbs.db
/.idea
/.nova
/.vscode
/.zed
/.cursor/
/.codex

# Anything that holds a secret. None of these is tracked and none should be:
# the program keeps its keys in its own settings, not in the source tree.
.env
.env.*
/auth.json

# What the program writes while it runs. A database or a log inside a checkout
# is somebody's real brain, which is not source and must never be committed.
*.log
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Release artefacts — built by `make packages` and by CI, not committed.
/dist
/clients/dist
build/

# Build tools fetched on demand, never committed: the Godot editor and its
# export templates are about 1.4GB between them and are not part of the source.
.tools/
