# PN Scripts Assistant updates, through apt.
#
# Installed by the pn-scripts-assistant package, or by hand with the one line
# in docs/guide/installing.md. With it, Software Updater (or `sudo apt upgrade`)
# brings every new version like any other update. The key below is the
# repository's own signing key, so this file trusts it for this repository
# only. Delete this file to stop the updates; the program keeps working.
Types: deb
URIs: https://pnscripts.github.io/pn-scripts-assistant/apt
Suites: stable
Components: main
Architectures: amd64
